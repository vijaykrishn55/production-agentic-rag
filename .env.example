# Replace before any shared or production deployment.
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-an-independent-internal-secret
POSTGRES_PASSWORD=local-rag-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-this-grafana-password

# Provider configuration. Groq is OpenAI-compatible; set LLM_ENABLED=true for live generation.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=

# Retrieval profiles: hash + lexical are light development settings.
INSTALL_FEATURES=lite
EMBEDDING_BACKEND=hash
RERANKER_BACKEND=lexical
# Production profile (install full extras and use a larger host):
# INSTALL_FEATURES=full
# EMBEDDING_BACKEND=sentence-transformer
# RERANKER_BACKEND=cross-encoder

REQUEST_TOKEN_BUDGET=8192
GENERATION_TOKEN_RESERVE=900
EVALUATION_TOKEN_RESERVE=500
MAX_AGENT_ITERATIONS=3
RATE_LIMIT_PER_MINUTE=50
CACHE_ENABLED=true
CACHE_BACKEND=memory
RAGAS_ENABLED=false
SEED_DEMO_DATA=true
